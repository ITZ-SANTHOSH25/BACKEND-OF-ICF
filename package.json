{
  "name": "lifelink-backend",
  "version": "1.0.0",
  "description": "LifeLink backend server with database, authentication, case management, donations, and role-based access.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "postinstall": "npm rebuild better-sqlite3 --build-from-source"
  },
  "keywords": [
    "lifelink",
    "healthcare",
    "donation",
    "crowdfunding",
    "express",
    "sqlite"
  ],
  "author": "LifeLink",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nanoid": "^3.3.7"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}
