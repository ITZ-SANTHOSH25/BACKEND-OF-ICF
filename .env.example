PORT=5000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:5000
CORS_ORIGIN=*
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ChildCrowdfunding?retryWrites=true&w=majority
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Cashfree Payment Gateway (use sandbox credentials for testing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_ENVIRONMENT=sandbox
# Full frontend site URL, e.g. https://yourname.github.io/ICF/
FRONTEND_RETURN_URL=
