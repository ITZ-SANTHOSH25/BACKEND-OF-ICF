# ---- LifeLink Backend configuration ----
# Copy this file to `.env` and adjust as needed.

# Server
PORT=5050
NODE_ENV=development

# Public base URL (used for building file URLs)
PUBLIC_BASE_URL=http://localhost:5050

# Comma-separated list of allowed CORS origins ("*" to allow all)
CORS_ORIGIN=*

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# SQLite database file (relative to project root)
DB_FILE=./data/lifelink.db

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
